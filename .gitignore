# IDE and generated project files
*.code-workspace
*.opensdf
*.sdf
*.sln
*.sln.DotSettings.user
*.slnx
*.suo
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.xcodeproj
*.xcworkspace
.idea/
.vs/
.vscode/
.vsconfig
compile_commands.json

# This is specific to Unreal's VS Code project generator.
.ignore

# Compiled Object files
*.lo
*.o
*.obj
*.slo

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.dll
*.dylib
*.so

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.app
*.exe
*.ipa
*.out

# Precompiled Assets
**/SourceArt/**/*.png
**/SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
**/Build/**

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!**/Build/**/
!**/Build/**/PakBlacklist*.txt

# Don't ignore icon files in Build
!**/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# In case users want to make their own copies of the build scripts for their own use.
**/Build-Windows-Local.bat
**/Build-Windows-Local.ps1

# Unreal build products and local state
**/BuildArtifacts/
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/
ArchivedBuilds/

# Generated Steam content-builder output, if the existing build tools are copied.
/BuildTool/steamworks_sdk_*/tools/ContentBuilder/output/

# Cache files for the editor to use
DerivedDataCache/*
Binds.Cache
Binds.Cache.Headers

# Debug data, build caches, and backups.
*.pdb
*.uba
*.blend1
enc_temp_folder/
__pycache__/
*.py[co]

# Operating system files
.DS_Store
[Dd]esktop.ini
Thumbs.db
*~
